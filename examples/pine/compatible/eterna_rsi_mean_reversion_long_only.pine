// This is a simplified long-only adaptation, not the upstream multi-indicator
// strategy. It removes shorts, MACD/Stochastic/Momentum, leverage, and alerts.
strategy("Eterna RSI Mean Reversion - Long Only",
    overlay=false,
    initial_capital=10000,
    default_qty_type=strategy.percent_of_equity,
    default_qty_value=25)

rsiLength = input.int(14, "RSI Length")
oversoldLevel = input.float(30, "Oversold recovery")
exitLevel = input.float(55, "Exit recovery")

rsiValue = ta.rsi(close, rsiLength)
enterLong = ta.crossover(rsiValue, oversoldLevel)
exitLong = ta.crossover(rsiValue, exitLevel)

if enterLong
    strategy.entry("Long", strategy.long)
if exitLong
    strategy.close("Long")

plot(rsiValue, "RSI")
